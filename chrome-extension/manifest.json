{
  "manifest_version": 3,
  "name": "Vinted Manager - Extension de Synchronisation",
  "version": "1.0.0",
  "description": "Scrape et synchronise automatiquement les vues, favoris, messages et ventes Vinted vers votre serveur Vinted Manager.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.com/*",
    "https://*.vinted.be/*",
    "https://*.vinted.es/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vinted Manager Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.com/*",
        "https://*.vinted.be/*",
        "https://*.vinted.es/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
